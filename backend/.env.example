# Efoy Hotel & Suites — Backend Environment Template
# Copy this file to .env and configure with your local secrets

PORT=5000
NODE_ENV=development

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=efoy_hotel
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Authentication (generate a strong random secret in production)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Chapa Payment Gateway Configuration (Server-Side Secrets)
# Never expose CHAPA_SECRET_KEY in frontend / browser client!
CHAPA_SECRET_KEY=CHASECK_TEST-placeholder_secret_key
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-placeholder_public_key
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here
CHAPA_CALLBACK_URL=http://localhost:5000/api/payments/chapa/webhook
